# NVIDIA hosts: serve the chat model with vLLM instead of Ollama.
#   cp .env.gpu.example .env.gpu
#   docker compose --profile gpu --env-file .env.gpu up -d
# Embeddings stay on Ollama (nomic-embed-text), so that model is still required.

API_PORT=8000

LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_MAX_TOKENS=400
# Seconds to wait on the LLM or embedding server before the API answers 504
LLM_TIMEOUT_S=180

EMBED_BASE_URL=http://ollama:11434/v1
EMBED_MODEL=nomic-embed-text
REQUIRED_OLLAMA_MODELS=nomic-embed-text
PULL_MODELS=nomic-embed-text

LOG_LEVEL=INFO
