# Copy to .env to override defaults. Every value below is also the built-in default.

# Host port for the web UI and API (bound to 127.0.0.1 only)
API_PORT=8000

# LLM and embeddings, both through OpenAI-compatible endpoints
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.2:3b
LLM_MAX_TOKENS=400
EMBED_BASE_URL=http://ollama:11434/v1
EMBED_MODEL=nomic-embed-text

# Models the offline check requires in the Ollama volume (space separated)
REQUIRED_OLLAMA_MODELS=llama3.2:3b nomic-embed-text
# Models `make pull-models` downloads (online machine only)
PULL_MODELS=llama3.2:3b nomic-embed-text

LOG_LEVEL=INFO
